SOURCE_SUPABASE_URL=https://your-source-project.supabase.co
SOURCE_SUPABASE_KEY=your-source-project-key
TARGET_SUPABASE_URL=https://your-target-project.supabase.co
TARGET_SUPABASE_KEY=your-target-project-key

# Tables in each Supabase project
SOURCE_TABLE=raw_leaks
TARGET_TABLE=leaked_data

# Polling and batching
POLL_INTERVAL_SECONDS=60
BATCH_SIZE=500

# Defaults used when a source record has no matching value
DEFAULT_FILE_NAME=raw_leaks
DEFAULT_SOURCE_CHANNEL=raw_leaks
DEFAULT_STATUS=new
